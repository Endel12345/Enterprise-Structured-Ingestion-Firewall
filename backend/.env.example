# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, add these as Environment Variables instead of using a file.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# The Groq model to use
GROQ_MODEL=openai/gpt-oss-120b

# Websites allowed to call the API, comma-separated (no trailing slash).
# Local default works with the Vite dev server. In production use your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string (e.g. a free Neon database). When set, chats are
# stored there; leave it empty to use a local SQLite file instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: days archived/deleted chats are kept before being removed for good (default 30)
# ARCHIVE_RETENTION_DAYS=30

# Optional: where to store chat history. Defaults to backend/data/chat.db
# On Render with a persistent disk mounted at /var/data, use /var/data/chat.db
# SQLITE_PATH=data/chat.db
